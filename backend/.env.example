# Copia este archivo a `.env` y ajusta los valores para tu entorno local.
# docker-compose.yml lee estas variables para levantar Postgres+PostGIS.

POSTGRES_DB=viasegura
POSTGRES_USER=viasegura
POSTGRES_PASSWORD=viasegura
POSTGRES_PORT=5432

# Secreto para firmar los JWT: Base64 de al menos 32 bytes, propio de cada
# entorno y nunca versionado (DEP-01, SEC-03 en README.md). Generalo con:
#   openssl rand -base64 48
# Sin valor por defecto: fuera del perfil local la app NO arranca si falta.
# En el perfil local (el de `mvn spring-boot:run`) puede quedar sin exportar
# y se usa el secreto de desarrollo de application-local.yml; si la exportas,
# que no quede vacia.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Web Push (US-21). Opcional: sin estas tres el canal push queda no
# disponible y los avisos van por correo. Genera un par propio con
#   npx web-push generate-vapid-keys
# y NO lo subas al repositorio.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@viasegura.pe

# Correo saliente (DEP-08, README "Correo saliente"). En local, `smtp` con
# Mailhog (docker compose, UI en :8025); no hace falta tocar nada.
# `resend` envia por la API HTTP de Resend: exige CORREO_API_KEY y un
# NOTIF_FROM de un dominio verificado en Resend. La clave NO se sube al
# repositorio.
CORREO_TIPO=smtp
CORREO_API_KEY=
# NOTIF_FROM=Ciudad Viva <no-reply@tu-dominio-verificado>

# Captcha del registro (NC-08 y NC-08b, README "Captcha en el registro"). En
# local, `ninguno`: el registro no exige captcha. `turnstile` verifica el
# widget de Cloudflare Turnstile y exige CAPTCHA_SECRET (la clave secreta del
# widget; NO se sube al repositorio). `recaptcha` ya no existe (28/10).
# Para probar el flujo en local sin crear un widget, Cloudflare publica claves
# de prueba (nunca van a produccion). El frontend usa la site key y el backend
# la secreta; con ellas el token es XXXX.DUMMY.TOKEN.XXXX y el hostname de la
# respuesta es example.com (por eso CAPTCHA_HOSTNAMES va vacia en local):
#   site key, siempre aprueba (visible):   1x00000000000000000000AA
#   site key, siempre falla (visible):     2x00000000000000000000AB
#   secret, siempre aprueba:               1x0000000000000000000000000000000AA
#   secret, siempre rechaza:               2x0000000000000000000000000000000AA
#   secret, token ya usado:                3x0000000000000000000000000000000AA
# CAPTCHA_TIPO=ninguno
# CAPTCHA_SECRET=
# Hostnames admitidos, separados por coma (en prod, por defecto
# ciudadviva.app,www.ciudadviva.app; vacia, no se comparan).
# CAPTCHA_HOSTNAMES=

# Confirmacion del correo (NC-09, README "Confirmacion del correo"). El
# registro rechaza los dominios desechables siempre (lista versionada, sin
# red). Con `dns` ademas consulta el MX del dominio (por defecto en prod); en
# local, `ninguno` por defecto, para poder registrar cuentas @viasegura.test.
# El enlace del correo apunta a FRONTEND_URL o, sin ella, al primer origen de
# CORS_ALLOWED_ORIGINS (http://localhost:3000 en local). El correo sale por
# CORREO_TIPO: en local, a Mailhog (UI en :8025), donde se abre el enlace.
# DOMINIO_CORREO_TIPO=ninguno
# FRONTEND_URL=http://localhost:3000

# Primer ADMIN (DEP-04, README "Operacion en produccion"). Solo actua en una
# base sin ningun ADMIN; sin ADMIN_INICIAL_EMAIL no pasa nada. La
# contrasena: 12 caracteres o mas y 72 bytes como maximo. Despues del primer
# arranque se borra ADMIN_INICIAL_PASSWORD; las otras dos pueden quedar.
# ADMIN_INICIAL_EMAIL=
# ADMIN_INICIAL_PASSWORD=
# ADMIN_INICIAL_NOMBRE=

# Sugerencia de categoria por la foto (NC-04 y NC-04b, README "Sugerencia de
# categoria"). En local el clasificador falso "detecta" un bache en cualquier
# foto: no hace falta tocar nada. Para probar el modelo real, levanta el
# servicio de inferencia
#   docker run --rm -d --name inferencia -p 8090:8000 --cpus=2 ciudadviva-inferencia
# y descomenta estas dos (CLASIFICACION_URL es la base, sin /v1/...):
# CLASIFICACION_TIPO=http
# CLASIFICACION_URL=http://localhost:8090
