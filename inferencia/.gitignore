# Entornos virtuales (servicio y exportación)
.venv/
.venv-*/

# Pesos y modelos exportados: no se versionan (README, «Obtener el modelo»).
# Sí se versiona modelos/modelo.json, que registra el hash del .onnx.
modelos/*.onnx
modelos/*.onnx.data
*.pth
*.pt

# Caché y artefactos de Python
__pycache__/
*.py[cod]
.pytest_cache/
.import_linter_cache/
.coverage
htmlcov/
